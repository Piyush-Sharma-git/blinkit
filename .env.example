# Copy this file to .env and change the values.
# .env is read by config.py (python-dotenv). Never share your real .env.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Optional: where the SQLite database file lives (default: instance/blinkit.db)
# DATABASE_PATH=instance/blinkit.db
